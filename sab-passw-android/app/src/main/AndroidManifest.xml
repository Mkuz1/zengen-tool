<?xml version="1.0" encoding="utf-8"?>
<!--
  SAB Passw is offline by design: there is deliberately NO <uses-permission android:name="android.permission.INTERNET"/>.
  Without it Android blocks every network socket the app (and its WebView) could open.
  Cloud backup and device-to-device transfer are also disabled, so the vault never leaves this phone.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:label="SAB Passw"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:hasFragileUserData="false"
        android:supportsRtl="true"
        android:theme="@style/SabTheme"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
